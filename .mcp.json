{
  "mcpServers": {
    "apify": {
      "command": "npx",
      "args": [
        "-y",
        "@apify/actors-mcp-server",
        "--actors", "azzouzana/immobiliare-it-listing-page-scraper-by-search-url,igolaizola/idealista-scraper"
      ],
      "env": {
        "APIFY_TOKEN": "${APIFY_API_TOKEN}"
      }
    },
    "suedtirol-immobilien": {
      "command": "python",
      "args": ["suedtirol-immobilien/mcp_server/main.py"],
      "env": {
        "APIFY_API_TOKEN": "${APIFY_API_TOKEN}"
      }
    }
  }
}
